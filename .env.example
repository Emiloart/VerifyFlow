NODE_ENV=development
DATABASE_URL=postgres://verifyflow:verifyflow@localhost:55432/verifyflow
VERIFYFLOW_API_PORT=4100
VERIFYFLOW_WEB_ORIGIN=http://localhost:3000
VERIFYFLOW_INVITE_ALLOWLIST=friend@example.com
VERIFYFLOW_WEB_API_TOKEN=replace-with-local-web-api-token
VERIFYFLOW_TEST_AUTH_ENABLED=true
VERIFYFLOW_TEST_AUTH_EMAIL=friend@example.com

NEXT_PUBLIC_VERIFYFLOW_API_BASE_URL=http://localhost:4100
AUTH_SECRET=replace-with-local-random-secret
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

KYC_PROVIDER_MODE=mock
KYC_PROVIDER_ID=mock-provider

# Required only when KYC_PROVIDER_MODE=http.
KYC_PROVIDER_TOKEN_URL=http://localhost:4444/oauth2/token
KYC_PROVIDER_ISSUE_URL=http://localhost:8081/v1/issuer/credentials
KYC_PROVIDER_VERIFY_URL=http://localhost:8082/v1/verifier/verifications
KYC_PROVIDER_SUPERSEDE_URL_TEMPLATE=http://localhost:8081/v1/issuer/credentials/{providerRunId}/status
KYC_PROVIDER_TEMPLATE_ID=passport-basic
KYC_PROVIDER_POLICY_ID=passport-basic
KYC_PROVIDER_ISSUE_SCOPE="issuer.credentials.issue issuer.credentials.read issuer.credentials.status.write"
KYC_PROVIDER_VERIFY_SCOPE="verifier.requests.create verifier.results.read"
KYC_PROVIDER_ISSUE_CLIENT_ID=replace-with-provider-issue-client-id
KYC_PROVIDER_ISSUE_CLIENT_SECRET=replace-with-provider-issue-client-secret
KYC_PROVIDER_VERIFY_CLIENT_ID=replace-with-provider-verify-client-id
KYC_PROVIDER_VERIFY_CLIENT_SECRET=replace-with-provider-verify-client-secret
