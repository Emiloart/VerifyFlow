{
  "name": "verifyflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.13",
    "next": {
      "postcss": "^8.5.13"
    }
  },
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint \"apps/web/**/*.{ts,tsx}\" \"services/api/src/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "typecheck": "tsc --build --pretty false && npm run typecheck -w apps/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/e2e-local.sh",
    "governance": "node scripts/check-governance.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "validate": "npm run governance && npm run check:no-secrets && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.13"
  }
}
